<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_barcode" model="ir.ui.view">
        <field name="name">account.move.form.barcode</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Botón para regenerar códigos -->
            <xpath expr="//header" position="inside">
                <button name="action_regenerate_barcodes" string="Regenerate Barcodes" type="object" class="oe_highlight"/>
            </xpath>
            <!-- Mostrar el barcode general -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="barcode_image" widget="image" readonly="1"/>
            </xpath>
            <!-- Mostrar el barcode por línea -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="after">
                <field name="line_barcode_image" widget="image" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>